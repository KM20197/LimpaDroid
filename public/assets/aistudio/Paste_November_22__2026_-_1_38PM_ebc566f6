+    assertEquals(TrashEntryState.IN_TRASH.name, dao.rows.getValue("legacy-failed").state)
+    assertTrue(Files.exists(storage.resolveMetadataPath(entryDir), LinkOption.NOFOLLOW_LINKS))
+  }
+
+  // ---- A2: caminhos da lixeira nunca são confiados cegamente ----
+
+  @Test
+  fun `purge and restore refuse an unmanaged trashPath and keep every file`() = runTest {
+    val dcim = Files.createDirectories(storageRoot.resolve("DCIM/Camera"))
+    val photos = listOf("a.jpg", "b.jpg", "c.jpg", "d.jpg").map { Files.writeString(dcim.resolve(it), "foto-$it") }
+    val sibling = Files.writeString(dcim.resolve("irma.jpg"), "irma")
+    val original = storageRoot.resolve("Pictures/x.jpg")
+    dao.rows["t-expired"] = inTrashRow("t-expired", photos[0], original)
+    dao.rows["t-empty"] = inTrashRow("t-empty", photos[1], original).copy(expiresAt = now + 100_000L)
+    dao.rows["t-manual"] = inTrashRow("t-manual", photos[2], original).copy(expiresAt = now + 100_000L)
+    dao.rows["t-restore"] = inTrashRow("t-restore", photos[3], original).copy(expiresAt = now + 100_000L)
