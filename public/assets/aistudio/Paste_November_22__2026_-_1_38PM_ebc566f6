+
+    assertEquals(0, repo.purgeExpired().purgedCount)
+    assertEquals(TrashEntryState.FAILED.name, dao.rows.getValue("t-expired").state)
+
+    assertEquals(0, repo.deletePermanently("t-manual").purgedCount)
+    assertEquals(TrashEntryState.FAILED.name, dao.rows.getValue("t-manual").state)
+
+    assertTrue(repo.restoreEntry("t-restore") is TrashRestoreResult.Rejected)
+
+    assertEquals(0, repo.emptyTrash().purgedCount)
+    assertEquals(TrashEntryState.FAILED.name, dao.rows.getValue("t-empty").state)
+
+    photos.forEach { assertTrue(Files.exists(it, LinkOption.NOFOLLOW_LINKS)) }
+    assertTrue(Files.exists(sibling, LinkOption.NOFOLLOW_LINKS))
+    assertTrue(Files.exists(dcim, LinkOption.NOFOLLOW_LINKS))
+  }
+
+  @Test
+  fun `index rebuild derives the payload path from the directory and ignores a tampered metadata trashPath`() =
+    runTest {
+      val external = Files.writeString(
+        Files.createDirectories(storageRoot.resolve("Download")).resolve("externo.bin"),
+        "nao-e-da-lixeira",
+      )
+      val trashRoot = storage.resolveTrashRoot(storageRoot)
+      val entryDir = storage.allocateEntryDir(trashRoot, "rebuilt-1", now)
+      Files.createDirectories(entryDir)
+      val payload = Files.writeString(storage.resolvePayloadPath(entryDir), "legitimo")
+      storage.writeMetadata(
+        storage.resolveMetadataPath(entryDir),
+        TrashMetadataPayload(
+          id = "rebuilt-1",
+          originalPath = storageRoot.resolve("Pictures/old.jpg").toString(),
+          trashPath = external.toString(),
+          sizeBytes = 8L,
+          sha256 = null,
+          originalMtime = 1L,
+          category = Category.SUPERFLUOUS.name,
+          ruleId = "TEST",
+          deletedAt = now - 10_000L,
+          expiresAt = now - 1L,
+        ),
+      )
+      val repo = repository()
+
+      repo.reconcilePendingAndRebuildIndex()
+
+      assertEquals(payload.toString(), dao.rows.getValue("rebuilt-1").trashPath)
+      assertEquals(1, repo.purgeExpired().purgedCount)
+      assertFalse(Files.exists(entryDir, LinkOption.NOFOLLOW_LINKS))
+      assertTrue(Files.exists(external, LinkOption.NOFOLLOW_LINKS))
+    }
+
+  // ---- A4: exclusão mútua entre movimentação e manutenção ----
+
+  @Test
+  fun `reconcile waits for a move in progress instead of interfering with it`() = runTest {
+    val (file, candidate) = downloadCandidate("grande.tmp", "conteudo-grande")
+    val gate = CompletableDeferred<Unit>()
+    dao.onUpsert = { entry -> if (entry.state == TrashEntryState.PENDING.name) gate.await() }
+    val repo = repository()
+
+    val moveJob = launch { repo.moveToTrash(candidate) }
+    yield()
+    var reconciled = false
+    val reconcileJob = launch {
+      repo.reconcilePendingAndRebuildIndex()
+      reconciled = true
+    }
+    yield()
+    // Tempo real (Dispatchers.Default): sem exclusão mútua, a reconciliação já teria consultado o índice.
+    withContext(Dispatchers.Default) { delay(300) }
+
+    assertEquals(0, dao.getByStateCalls)
+    assertFalse(reconciled)
+
+    gate.complete(Unit)
+    moveJob.join()
+    reconcileJob.join()
+
+    assertTrue(reconciled)
+    assertFalse(Files.exists(file, LinkOption.NOFOLLOW_LINKS))
+    val row = dao.rows.values.single()
+    assertEquals(TrashEntryState.IN_TRASH.name, row.state)
+    assertNotNull(row.trashPath)
+  }
+
+  // ---- Fakes ----
+
+  private class FakeTrashEntryDao : TrashEntryDao {
+    val rows = LinkedHashMap<String, TrashEntryEntity>()
+    var failMovedStateUpdates = 0
+    var getByStateCalls = 0
+    var beforeMovedStateUpdate: (suspend () -> Unit)? = null
+    var onUpsert: (suspend (TrashEntryEntity) -> Unit)? = null
+    private val inTrash = MutableStateFlow<List<TrashEntryEntity>>(emptyList())
+    private val purged = MutableStateFlow<List<TrashEntryEntity>>(emptyList())
+
+    private fun publish() {
+      inTrash.value = rows.values.filter { it.state == TrashEntryState.IN_TRASH.name }
+      purged.value = rows.values.filter { it.state == TrashEntryState.PURGED.name }
+    }
+
+    override fun observeInTrashEntries(): Flow<List<TrashEntryEntity>> = inTrash
+
+    override fun observePurgedEntries(): Flow<List<TrashEntryEntity>> = purged
+
+    override suspend fun getById(id: String): TrashEntryEntity? = rows[id]
+
+    override suspend fun getByState(state: String): List<TrashEntryEntity> {
+      getByStateCalls += 1
+      return rows.values.filter { it.state == state }
+    }
+
+    override suspend fun getExpiredEntries(nowMillis: Long): List<TrashEntryEntity> =
+      rows.values.filter { it.state == TrashEntryState.IN_TRASH.name && it.expiresAt <= nowMillis }
+
+    override suspend fun upsert(entry: TrashEntryEntity) {
+      onUpsert?.invoke(entry)
+      rows[entry.id] = entry
+      publish()
+    }
+
+    override suspend fun updateMovedState(
+      id: String,
+      state: String,
+      trashPath: String,
+      sizeBytes: Long,
+      sha256: String?,
+      originalMtime: Long,
+      failureReason: String?,
+    ) {
+      beforeMovedStateUpdate?.invoke()
+      if (failMovedStateUpdates > 0) {
+        failMovedStateUpdates -= 1
+        throw IOException("falha simulada ao gravar o índice")
+      }
+      val current = rows[id] ?: return
+      rows[id] = current.copy(
+        state = state,
+        trashPath = trashPath,
+        sizeBytes = sizeBytes,
+        sha256 = sha256,
+        originalMtime = originalMtime,
+        failureReason = failureReason,
+      )
+      publish()
+    }
+
+    override suspend fun updateLifecycleState(
+      id: String,
+      state: String,
+      restoredAt: Long?,
+      restoredPath: String?,
+      purgedAt: Long?,
+      failureReason: String?,
+    ) {
+      val current = rows[id] ?: return
+      rows[id] = current.copy(
+        state = state,
+        restoredAt = restoredAt,
+        restoredPath = restoredPath,
+        purgedAt = purgedAt,
+        failureReason = failureReason,
+      )
+      publish()
+    }
+  }
+
+  private class FakeOperationHistoryDao : OperationHistoryDao {
+    override fun observeRecent(limit: Int): Flow<List<OperationHistoryEntity>> = flowOf(emptyList())
+
+    override suspend fun insert(record: OperationHistoryEntity): Long = 1L
+  }
+}
