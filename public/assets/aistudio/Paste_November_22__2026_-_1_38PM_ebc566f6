+/**
+ * Cenários de resiliência da lixeira (A1, A2 e A4) com DAOs em memória: não dependem de Room nem de
+ * Robolectric e exercitam falhas injetadas entre as etapas de uma movimentação.
+ */
+class TrashRepositoryResilienceTest {
+
+  @get:Rule
+  val tempFolder = TemporaryFolder()
+
+  private lateinit var storageRoot: Path
+  private lateinit var dao: FakeTrashEntryDao
+  private val storage = TrashStorage()
+  private val now = 1_700_000_000_000L
+
+  @Before
+  fun setUp() {
+    storageRoot = tempFolder.newFolder("shared_storage").toPath().toRealPath()
+    dao = FakeTrashEntryDao()
+  }
+
+  private fun repository(): TrashRepository = TrashRepository(
+    trashEntryDao = dao,
+    operationHistoryDao = FakeOperationHistoryDao(),
+    storageVolumeResolver = object : StorageVolumeResolver {
+      override fun resolvePrimarySharedStorage(): StorageRootResolution =
+        StorageRootResolution.Available(storageRoot, "Armazenamento de teste")
+    },
+    mediaScannerHook = MediaScannerHook { },
+    scanLogger = object : ScanLogger {
+      override fun logEvent(tag: String, message: String) = Unit
+    },
+    applicationId = "io.github.km20197.limpadroid",
+    clock = AppClock { now },
+  )
+
+  private fun downloadCandidate(name: String, content: String): Pair<Path, Candidate> {
+    val dir = Files.createDirectories(storageRoot.resolve("Download"))
+    val file = Files.writeString(dir.resolve(name), content)
+    val mtime = 1_690_000_000_000L
+    Files.setLastModifiedTime(file, FileTime.fromMillis(mtime))
+    return file to Candidate(
+      path = file.toString(),
+      sizeBytes = content.length.toLong(),
+      lastModified = mtime,
+      category = Category.SUPERFLUOUS,
+      ruleId = "PARTIAL_DL",
+      confidence = Confidence.HIGH,
+    )
+  }
+
+  private fun inTrashRow(
+    id: String,
+    trashPath: Path,
+    originalPath: Path,
+    state: TrashEntryState = TrashEntryState.IN_TRASH,
+  ) = TrashEntryEntity(
+    id = id,
+    originalPath = originalPath.toString(),
+    trashPath = trashPath.toString(),
+    sizeBytes = 4L,
+    sha256 = null,
+    originalMtime = 100L,
+    category = Category.SUPERFLUOUS.name,
+    ruleId = "TEST",
+    deletedAt = now - 10_000L,
+    expiresAt = now - 1L,
+    state = state.name,
+  )
+
+  // ---- A1: falha ou cancelamento depois que o arquivo já está na lixeira ----
+
+  @Test
+  fun `failure after the file reached the trash keeps the entry PENDING and reconcile promotes it`() = runTest {
+    val (file, candidate) = downloadCandidate("relatorio.tmp", "conteudo")
+    dao.failMovedStateUpdates = Int.MAX_VALUE
+    val repo = repository()
+
+    val result = repo.moveToTrash(candidate)
+
+    assertTrue(result is TrashMoveResult.Failed)
+    assertFalse(Files.exists(file, LinkOption.NOFOLLOW_LINKS))
+    val pending = dao.rows.values.single()
+    assertEquals(TrashEntryState.PENDING.name, pending.state)
+    assertTrue(Files.exists(java.nio.file.Paths.get(pending.trashPath), LinkOption.NOFOLLOW_LINKS))
+
+    dao.failMovedStateUpdates = 0
+    repo.reconcilePendingAndRebuildIndex()
+
+    val recovered = dao.rows.getValue(pending.id)
+    assertEquals(TrashEntryState.IN_TRASH.name, recovered.state)
+    assertTrue(
+      Files.exists(
+        storage.resolveMetadataPath(java.nio.file.Paths.get(pending.trashPath).parent),
+        LinkOption.NOFOLLOW_LINKS,
+      ),
+    )
+  }
+
+  @Test
+  fun `a single failure after the move is settled immediately and reported as Moved`() = runTest {
+    val (file, candidate) = downloadCandidate("foto.tmp", "dados")
+    dao.failMovedStateUpdates = 1
+    val repo = repository()
+
+    val result = repo.moveToTrash(candidate)
+
+    assertTrue(result is TrashMoveResult.Moved)
+    assertFalse(Files.exists(file, LinkOption.NOFOLLOW_LINKS))
+    assertEquals(TrashEntryState.IN_TRASH.name, dao.rows.values.single().state)
+  }
+
+  @Test
+  fun `cancellation after the move still records the entry and propagates`() = runTest {
+    val (file, candidate) = downloadCandidate("video.tmp", "bytes")
+    var fired = false
+    dao.beforeMovedStateUpdate = {
+      if (!fired) {
+        fired = true
+        currentCoroutineContext()[Job]!!.cancel()
+        currentCoroutineContext().ensureActive()
+      }
+    }
+    val repo = repository()
+
+    val moveJob = launch { repo.moveToTrash(candidate) }
+    moveJob.join()
+
+    assertTrue(fired)
+    assertTrue(moveJob.isCancelled)
+    assertFalse(Files.exists(file, LinkOption.NOFOLLOW_LINKS))
+    val row = dao.rows.values.single()
+    assertEquals(TrashEntryState.IN_TRASH.name, row.state)
+    assertTrue(Files.exists(java.nio.file.Paths.get(row.trashPath), LinkOption.NOFOLLOW_LINKS))
+  }
